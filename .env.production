# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=replace-with-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret-min-32-chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Database Configuration
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=https://chatapp-frontend-uw70.onrender.com
